# MongoDB connection
MONGO_URI=mongodb://localhost:27017

# Discord OAuth (leave blank for guest mode)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Session
SESSION_SECRET=wowdraft-dev-secret

# Server
NODE_ENV=development
PORT=3000

# Warcraft Logs API (register at https://www.warcraftlogs.com/api/clients)
WCL_CLIENT_ID=
WCL_CLIENT_SECRET=
