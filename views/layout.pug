doctype html
html
	head
		title #{title}
		link(rel='stylesheet', href='/stylesheets/style.css')
		script(src="https://cdn.jsdelivr.net/npm/vue@2")
		script(src='/javascripts/components/draft-info.js')
		script(src="https://code.jquery.com/jquery-3.6.0.min.js"
			  integrity="sha256-/xUj+3OJU5yExlq6GSYGSHk7tPXikynS7ogEvDej/m4="
			  crossorigin="anonymous")

		link(rel='preconnect' href='https://fonts.googleapis.com')
		link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin='')
		link(href='https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300;400;500;600;700&display=swap' rel='stylesheet')
		link(href='https://fonts.googleapis.com/css2?family=Open+Sans:wght@300;400;600;700&display=swap' rel='stylesheet')
		link(rel="stylesheet" href="https://use.fontawesome.com/releases/v5.12.1/css/all.css" crossorigin="anonymous")
		link(href="https://fonts.googleapis.com/css2?family=Montserrat:wght@100;300;400;500&display=swap" rel="stylesheet")

		
		link(rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png')
		link(rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png')
		link(rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png')
		link(rel='manifest' href='/site.webmanifest')
		link(rel='mask-icon' href='/safari-pinned-tab.svg' color='#5bbad5')
		meta(name='msapplication-TileColor' content='#da532c')
		meta(name='theme-color' content='#ffffff')
		meta(property="og:type" content="website")
		meta(property="og:site_name" content="WowDraft")



	body
		header
			div#navigation
				a(href="/leagues").
					<i class="fas fa-book"></i> All Leagues
				a(href="/leagues/create").
					<i class="fas fa-plus"></i> New League

			div.user-controls
				div#logged-in
					span
						p#username
					a(href="/logout").
						logout <i class="fas fa-sign-out-alt"></i>
				div#logged-out
					a(href="/login").
						login <i class="fas fa-sign-in-alt"></i>
		div#pool-build-banner(v-cloak style="display:none")
			div.pool-banner-content
				span.pool-banner-text {{poolMessage}}
				div.pool-banner-bar
					div.pool-banner-fill(:style="'width:' + poolPercent + '%'")
				span.pool-banner-detail {{poolProgress}} / {{poolTotal}}
				a.pool-banner-link(v-if="poolLeagueCode" :href="'/leagues/' + poolLeagueCode") View League →
				span.pool-banner-error(v-if="poolError") {{poolError}}
		block content

	footer
		p This site is under development! :) <3
		script.
			$("#logged-in").hide();

			var username = "#{user_session_name}"

			if(!{user_session_auth}) {
				$("#logged-out").hide();
				$("#logged-in").show();
				$("#username").text(username);
			}

			// Global pool-building progress banner
			(function() {
				var bannerEl = document.getElementById('pool-build-banner');
				if (!bannerEl) return;

				new Vue({
					el: '#pool-build-banner',
					data: {
						poolLeagueCode: null,
						poolMessage: '',
						poolProgress: 0,
						poolTotal: 0,
						poolError: '',
						_pollTimer: null,
					},
					computed: {
						poolPercent: function() {
							if (this.poolTotal <= 0) return 0;
							return Math.round((this.poolProgress / this.poolTotal) * 100);
						},
					},
					methods: {
						startPolling: function() {
							var self = this;
							if (self._pollTimer) clearInterval(self._pollTimer);
							self.$el.style.display = '';
							self._pollTimer = setInterval(function() {
								fetch('/leagues/api/' + self.poolLeagueCode + '/poolStatus')
									.then(function(res) { return res.json(); })
									.then(function(status) {
										if (status && status.state === 'done') {
											var msg = status.active + ' active raiders';
											if (status.inactive > 0) msg += ', ' + status.inactive + ' inactive';
											self.poolMessage = 'Player pool ready! ' + msg + '.';
											self.poolProgress = status.total || self.poolTotal;
											self.poolTotal = status.total || self.poolTotal;
											self.poolError = '';
											clearInterval(self._pollTimer);
											self._pollTimer = null;
											localStorage.removeItem('wowdraft_pool_building');
											setTimeout(function() { window.location.reload(); }, 2500);
										} else if (!status || !status.state || status.state === 'idle') {
											self.poolMessage = 'Player pool ready!';
											self.poolProgress = self.poolTotal;
											self.poolError = '';
											clearInterval(self._pollTimer);
											self._pollTimer = null;
											localStorage.removeItem('wowdraft_pool_building');
											setTimeout(function() { window.location.reload(); }, 1500);
										} else if (status.state === 'building') {
											self.poolMessage = status.message || 'Building...';
											self.poolProgress = status.progress || 0;
											self.poolTotal = status.total || 0;
											self.poolError = '';
										} else if (status.state === 'error') {
											self.poolMessage = '';
											self.poolError = status.message || 'An error occurred.';
											self.poolProgress = 0;
											self.poolTotal = 0;
											clearInterval(self._pollTimer);
											self._pollTimer = null;
										}
									})
									.catch(function() {
										clearInterval(self._pollTimer);
										self._pollTimer = null;
										self.clear();
									});
							}, 2000);
						},
						clear: function() {
							if (this._pollTimer) clearInterval(this._pollTimer);
							this._pollTimer = null;
							localStorage.removeItem('wowdraft_pool_building');
							this.$el.style.display = 'none';
							this.poolLeagueCode = null;
							this.poolMessage = '';
							this.poolProgress = 0;
							this.poolTotal = 0;
							this.poolError = '';
						},
					},
					mounted: function() {
						var code = localStorage.getItem('wowdraft_pool_building');
						if (code) {
							this.poolLeagueCode = code;
							this.poolMessage = 'Building player pool...';
							this.startPolling();
						}
					},
					beforeDestroy: function() {
						if (this._pollTimer) clearInterval(this._pollTimer);
					},
				});
			})();

