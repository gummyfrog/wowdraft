extends layout

block content
	div#teams
		div#content
			draft_info(
				v-bind:league_info="league_info",
				v-bind:status_slug="statusSlug",
				v-bind:is_admin="organizer",
				current_page="teams"
			)

			div.teams-grid(v-if="teams.length > 0")
				team-item(
					v-for="(team, index) in teams"
					v-bind:team="team"
					v-bind:index="index"
				)

			div.empty-state(v-else)
				i.fas.fa-users.empty-state-icon
				p.empty-state-message No teams registered yet
				p.empty-state-subtext Teams will appear here once players register.

	script.
		var league = !{JSON.stringify(league)}
		league = JSON.parse(league)

		Vue.component('team-item', {
			props: ['team', 'index'],
			template: `
			<div class="team-card-wrap">
				<div class="team-banner team-banner--sm" :class="'team-banner--' + (team.banner_shape || 'pointed')" :style="'--ban-bg:' + (team.banner_bg || team.color2 || '#555') + '; --ban-accent:' + (team.banner_accent || '#FFD100')" v-if="team.banner_shape">
					<div class="team-banner-bg" :class="'pat-' + (team.banner_pattern || 'solid')" :style="'background-color:' + (team.banner_bg || team.color2 || '#555')"></div>
					<div class="team-banner-emblem" :style="'color:' + (team.banner_emblem_color || '#fff')"><i :class="'fas fa-' + (team.banner_emblem || 'shield-alt')"></i></div>
				</div>
				<div class="team-card" :style="'border-color:' + (team.color2 || '#555')">
					<div class="team-card-head">
						<img :src="'/images/icons/'+team.icon+'.png'">
						<h2 :style="'color:'+team.color2">{{team.name}}</h2>
					</div>
					<div class="team-card-manager">{{team.manager}}</div>
					<div v-if="team.motto" class="team-card-motto" :style="'color:'+team.color2">{{team.motto}}</div>
					<div class="team-card-roster">
						<div v-for="player in team.drafted_players" class="roster-player">
							<img :src="'/images/classes/'+player.class+'.png'">
							<img :src="'/images/roles/'+player.role+'.png'">
							<span class="player-name" :class="player.class">{{player.name}}</span>
							<span class="player-guild">{{player.guild}}</span>
						</div>
						<div v-if="team.drafted_players.length === 0" class="roster-empty">No players drafted yet</div>
					</div>
				</div>
			</div>
			`
		})

		var app = new Vue({
		  el: '#teams',
		  data: {
		  	teams: league.teams,
		  	league_info: league,
		  	organizer: !{organizer},
		  },
		  computed: {
		  	statusSlug() {
		  		return this.league_info.status.toLowerCase().replace(" ", '-');
		  	}
		  }
		})