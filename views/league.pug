extends layout

block content

	div#league

		meta(property="og:title" :content="league.name")
		meta(property="og:image" :content="'/images/league_icons/' + league.icon")

		div#content

			draft_info(
				v-bind:league_info="league_info",
				v-bind:status_slug="statusSlug",
				v-bind:is_admin="organizer",
				current_page="home"
			)

			div.league-description-card(v-if="league_info.description")
				p.league-description-text {{league_info.description}}

			div.cta-card(v-if="league_info.pool_status && league_info.pool_status.state === 'building'")
				div.cta-card-body
					h2.cta-card-heading
						i.fas.fa-sync.fa-spin
						|  Building Player Pool...
					p.cta-card-subtext The player pool is being built from guild rosters. This may take a few minutes.

			div.cta-card.cta-card--warning(v-if="league_info.pool_status && league_info.pool_status.state === 'error'")
				div.cta-card-body
					h2.cta-card-heading
						i.fas.fa-exclamation-triangle
						|  Player Pool Error
					p.cta-card-subtext {{league_info.pool_status.message}}
					button.btn-styled.btn-styled--primary(@click="retryPoolBuild" :disabled="retryingPool")
						i.fas.fa-redo
						|  {{retryingPool ? ' Retrying...' : ' Retry'}}

			a.cta-card.cta-card--primary(v-if="organizer && league_info.status == 'Setting Up' && league_info.teams && league_info.teams.length >= 2 && (!league_info.pool_status || !league_info.pool_status.state)" :href="'/leagues/' + league_info.code + '/start'")
				div.cta-card-body
					h2.cta-card-heading
						i.fas.fa-hand-point-right
						|  Ready to go? Start Drafting!
					p.cta-card-subtext Your league has enough teams. Click to begin the draft.
					span.cta-card-action Start Draft →

			a.cta-card.cta-card--primary(v-if="canMakeTeam" :href="'/leagues/' + league_info.code + '/newTeam'")
				div.cta-card-body
					h2.cta-card-heading
						i.fas.fa-flag
						|  Register Your Team!
					p.cta-card-subtext Join this league by creating a team.
					span.cta-card-action Register →

			div.invite-link-row(v-if="league_info.status == 'Setting Up'")
				button.btn-styled.btn-styled--primary.btn-styled--small(@click="copyInviteLink")
					i.fas.fa-link
					|  {{inviteCopied ? ' Copied!' : ' Copy Invite Link'}}
				span.invite-link-hint Share this link to let managers register a team.

			draft_progress(
				v-bind:draft_info="draft_info",
				v-bind:teams="teams",
				v-bind:league_info="league_info"
				v-bind:yti="yourTeamIndex"
				v-bind:reqs="requirements"
			)

			div.cta-card.cta-card--warning(v-if="league_info.status == 'Drafted'")
				div.cta-card-body
					h2.cta-card-heading
						i.fas.fa-play
						|  Draft Complete! Ready to start the season?
					p.cta-card-subtext All teams have drafted their rosters. Start the season to begin matchups.
					form(:action="'/leagues/api/' + league_info.code + '/startSeason'" method="post")
						button.btn-styled.btn-styled--warning(type="submit")
							i.fas.fa-check
							|  Start Season

			div.season-info-card(v-if="league_info.status == 'Active'")
				div.season-info-card-head
					i.fas.fa-trophy
					span  Season Active
					span.season-info-week Week {{currentWeek}}
				div.season-info-card-details
					div.season-info-detail
						i.fas.fa-calendar-day
						span  Report Day: {{league_info.report_day || 'Wednesday'}}
				div.season-info-card-actions
					button.btn-styled.btn-styled--primary(@click="generateReport" :disabled="generating")
						i.fas.fa-sync(:class="{'fa-spin': generating}")
						|  {{reportLabel}}
					div.report-progress(v-if="generating && reportTotal > 0")
						div.report-progress-bar
							div.report-progress-fill(:style="'width:' + reportPercent + '%'")
						span.report-progress-text {{reportProgress}} / {{reportTotal}} players

			div.standings-card(v-if="league_info.standings")
				div.standings-card-head
					i.fas.fa-list-ol
					span  Standings
				div.standings-card-body
					div.standings-row(v-for="(team, index) in sortedTeams")
						span.standings-rank \#{{index + 1}}
						span.standings-name {{team.name}}
						span.standings-record {{getRecord(team.id)}}

			div.title-bar
				h2.
					<i class="fas fa-flag"></i>
					Registered Teams

			div.teams-grid(v-if="teams.length > 0")
				team-item(
					v-for="(team, index) in teams"
					v-bind:team="team"
					v-bind:index="index"
					v-bind:record="getRecord(team.id)"
				)

			div.empty-state(v-else)
				i.fas.fa-users.empty-state-icon
				p.empty-state-message No teams registered yet
				p.empty-state-subtext Be the first to join — register your team above!


	script.
		var league = !{JSON.stringify(league)}
		league = JSON.parse(league)

		Vue.component('team-item', {
			props: ['team', 'index', 'record'],
			template: `
			<div class="team-card-wrap">
				<div class="team-banner team-banner--sm" :class="'team-banner--' + (team.banner_shape || 'pointed')" :style="'--ban-bg:' + (team.banner_bg || team.color2 || '#555') + '; --ban-accent:' + (team.banner_accent || '#FFD100')" v-if="team.banner_shape">
					<div class="team-banner-bg" :class="'pat-' + (team.banner_pattern || 'solid')" :style="'background-color:' + (team.banner_bg || team.color2 || '#555')"></div>
					<div class="team-banner-emblem" :style="'color:' + (team.banner_emblem_color || '#fff')"><i :class="'fas fa-' + (team.banner_emblem || 'shield-alt')"></i></div>
				</div>
				<div class="team-card" :style="'border-color:' + (team.color2 || '#555')">
					<div class="team-card-head">
						<img :src="'/images/icons/'+team.icon+'.png'">
						<h2 :style="'color:'+team.color2">{{team.name}}</h2>
						<span v-if="record" class="team-record">{{record}}</span>
					</div>
					<div class="team-card-manager">{{team.manager}}</div>
					<div v-if="team.motto" class="team-card-motto" :style="'color:'+team.color2">{{team.motto}}</div>
					<div class="team-card-roster">
						<div v-for="player in team.drafted_players" class="roster-player">
							<img :src="'/images/classes/'+player.class+'.png'">
							<img :src="'/images/roles/'+player.role+'.png'">
							<span class="player-name" :class="player.class">{{player.name}}</span>
							<span class="player-guild">{{player.guild}}</span>
						</div>
						<div v-if="team.drafted_players.length === 0" class="roster-empty">No players drafted yet</div>
					</div>
				</div>
			</div>
			`
		})

		Vue.component('draft_progress', {
			props: ['draft_info', 'teams', 'league_info', 'yti', 'reqs'],
		 	template: `
		 	<div v-if="draft_info.status==1" class="draft"> 

		 			<div class="title-bar">
			 			<h2> <i class="fas fa-clock"></i> On The Clock: <br> {{teams[draft_info.pick_order[draft_info.pick_index]].manager}} ({{teams[draft_info.pick_order[draft_info.pick_index]].name}})</h2>
				 		<div v-if="!{organizer}" class="SKIP">
				 			<h3> ADMIN: Skip this team's turn? </skip>
				 			<a class="skipbutton" v-if="!{organizer}" :href="'/leagues/' + league_info.code + '/skip'"> Yep, skip! </a>
				 		</div>
			 		</div>

		 		<div v-if="draft_info.status==1" class="progress">



			 		<div class="youreup" v-if="draft_info.pick_order[draft_info.pick_index] == yti"> 
			 		    <audio id="audio" src="/sounds/levelup2.ogg" autoplay="true"> </audio>

			 			<h2> <i class="fas fa-user-clock"></i> You're Up! </h2>
			 			<ul class="requirements" v-html="reqs"> </ul>
			 		</div>

			 		<a class="view_players view_players_button" :href="'/proplayers/' + league_info.code"> <i class="fas fa-long-arrow-alt-right"></i> View Players </a>
		 		</div>
		 		<h1 v-else>Draft is over! Great job!</h1>


				<div class="title-bar">
		 			<h2><i class="fas fa-history"></i> Pick History: </h2>
		 		</div>

		 		<div v-if="draft_info.status!=0" class="pick_history">
		 			<div class="picks">
						<pick_history_item 
							v-for="(pick, index) in draft_info.picks"
							v-bind:pick="pick"
							v-bind:index="index">
					</div>
		 		</div>

		 		<div v-if="draft_info.status!=0">
		 			<div class="title-bar">
		 				 <h2><i class="fas fa-list-ul"></i> Pick Order: </h2>
		 			</div>

		 			<div class="pick_order">

					<pick_order_item 
						v-for="(team_number, index) in draft_info.pick_order"
						v-bind:team_number="team_number"
						v-bind:teams="teams"
						v-bind:index="index"
						v-bind:pick_index=draft_info.pick_index
						v-bind:picks=draft_info.picks
						v-bind:current="draft_info.pick_index">
					</div>
		 		</div>
		 	</div>
		 	`
		})

		Vue.component('pick_history_item', {
			props: ['pick', 'index'],
		 	template: `
		 	<div class="pick">
		 		<h1 class="pick_number"> {{index+1}} </h1>
			 	<h4 class="mini_team_name" :style="'color:'+pick.team.color2"> {{pick.team.name}} </h4> 
			 	<br>

			 	<img class="mini_role" :src="'/images/roles/'+pick.player.role+'.png'">
		 		<img class="mini_class" :src="'/images/classes/'+pick.player.class+'.png'">

			 	<h4 :class="'mini_player '+pick.player.class">{{pick.player.name}}</h4>
		 	</div>`
		})


		Vue.component('pick_order_item', {
			props: ['current', 'team_number', 'index', 'pick_index', 'teams', 'picks'],
		 	template: `
		 	<div class="pick_order_item current_pick" v-if="current==index">
		 		<h3 class="pick_order_number"> {{index+1}} </h3>
		 		<h4> {{teams[team_number].name}} </h4>
		 	</div>
		 	<div v-else-if="pick_index > index" class="pick_order_item past_order">
		 		<h3 class="pick_order_number"> {{index+1}} </h3>
		 		<h4> {{teams[team_number].name}} </h4>
		 	</div>
		 	<div v-else class="pick_order_item">
		 		<h3 class="pick_order_number"> {{index+1}} </h3>
		 		<h4> {{teams[team_number].name}} </h4>
		 	</div>
		 	`
		})

		Vue.component('mini_player', {
			props: ['player'],
		 	template: `
		 	<div class="team_mini_player">
		 	<img class="mini_role" :src="'/images/roles/'+player.role+'.png'">
		 	<img class="mini_class" :src="'/images/classes/'+player.class+'.png'">

			<span :class="'mini_player '+player.class">{{player.name}}</span>
			<span class="mini_guild">{{player.guild}}</span>
			</div>`
		})


		var app = new Vue({
		  el: '#league',
		  data: {
		  	teams: league.teams,
		  	league_info: league,
		  	organizer: !{organizer},
		  	canMakeTeam: !{canMakeTeam},
		  	has_real_draft_info: false,
		  	draft_info: {pick_order:[0], pick_index:0, started: false, inProgress:false},
		  	generating: false,
		  	reportProgress: 0,
		  	reportTotal: 0,
		  	retryingPool: false,
		  	inviteCopied: false,
		  	_pollTimer: null,
		  },
		  methods: {
			copyInviteLink: function() {
				var self = this;
				navigator.clipboard.writeText(location.origin + '/leagues/' + league.code + '/join')
					.then(function() {
						self.inviteCopied = true;
						setTimeout(function() { self.inviteCopied = false; }, 1500);
					});
			},
			fetchDraftData: function(event) {
				fetch(`/leagues/api/${league.code}/draftInfo`)
				.then(res => res.json())
				.then((response) => {
					app.draft_info = response
					app.has_real_draft_info = true;
				})
			},
			fetchData:function(event) {
				fetch(`/leagues/api/${league.code}`)
				.then(res => res.json())
				.then((response) => {
					league = response;
					this.teams = league.teams;
					this.league_info = league;
				})
			},
			generateReport: function() {
				this.generating = true;
				this.reportProgress = 0;
				this.reportTotal = 0;
				fetch(`/leagues/api/${league.code}/generateReport`, { method: 'POST' })
					.then(res => res.json())
					.then(() => { this.pollReportStatus(); })
					.catch(() => { this.generating = false; });
			},
			pollReportStatus: function() {
				var self = this;
				if (self._pollTimer) clearInterval(self._pollTimer);
				self._pollTimer = setInterval(function() {
					fetch(`/leagues/api/${league.code}/reportStatus`)
						.then(res => res.json())
						.then(function(status) {
							if (status.state === 'generating') {
								self.reportProgress = status.progress || 0;
								self.reportTotal = status.total || 0;
							} else {
								clearInterval(self._pollTimer);
								self._pollTimer = null;
								self.generating = false;
								self.reportProgress = 0;
								self.reportTotal = 0;
								self.fetchData();
							}
						})
						.catch(function() {
							clearInterval(self._pollTimer);
							self._pollTimer = null;
							self.generating = false;
						});
				}, 2000);
			},
			getRecord: function(teamId) {
				var s = this.league_info.standings && this.league_info.standings[teamId];
				return s ? s.wins + 'W - ' + s.losses + 'L' : '0W - 0L';
			},
			retryPoolBuild: function() {
				var self = this;
				self.retryingPool = true;
				fetch('/leagues/api/' + league.code + '/retryPool', { method: 'POST' })
					.then(function(res) { return res.json(); })
					.then(function(data) {
						if (data.started) {
							localStorage.setItem('wowdraft_pool_building', league.code);
							self.league_info.pool_status = { state: 'building', step: 'rosters', progress: 0, total: 0, message: 'Retrying...' };
						}
						self.retryingPool = false;
					})
					.catch(function() { self.retryingPool = false; });
			}
		  },
		  computed: {
		  	reportLabel: function() {
		  		if (!this.generating) return 'Update Scores';
		  		if (this.reportTotal > 0) return 'Fetching data...';
		  		return 'Starting...';
		  	},
		  	reportPercent: function() {
		  		if (this.reportTotal <= 0) return 0;
		  		return Math.round((this.reportProgress / this.reportTotal) * 100);
		  	},
		  	statusSlug() {
		  		return this.league_info.status.toLowerCase().replace(" ", '-');
		  	},
		  	noTeams() {
		  		return this.teams.length == 0;
		  	},
		  	yourTeamIndex() {
		  		var myName = `!{user_session_name}`;
		  		var myId = `!{user_session_id}`;
		  		for(var x=0; x<this.teams.length;x++) {
		  			var t = this.teams[x];
		  			if(t.manager_id && myId ? t.manager_id === myId : (myName && t.manager === myName)) {
		  				return x
			  		}
		  		}
		  		return -1;
		  	},
		  	requirements() {
		  		if(this.yourTeamIndex != -1) {
			  		var roles_drafted = this.teams[this.yourTeamIndex].roles_drafted;
			  		var reqs = this.league_info.requirements;
			  		var msg = "";

			  		if(roles_drafted.tanks < reqs.tanks) {
			  			msg += `<li> <i class="fas fa-exclamation-circle"></i> You need ${reqs.tanks-roles_drafted.tanks} more tank(s). </li>`
			  		}
			  		if(roles_drafted.dps < reqs.dps) {
			  			msg += `<li> <i class="fas fa-exclamation-circle"></i> You need ${reqs.dps-roles_drafted.dps} more dps.</li>`
			  		}
			  		if(roles_drafted.healers < reqs.healers) {
			  			msg += `<li> <i class="fas fa-exclamation-circle"></i> You need ${reqs.healers-roles_drafted.healers} more healer(s).</li>`
			  		}
			  		return msg;
		  		}
		  	},
		  	currentWeek: function() {
		  		return (this.league_info.activity_reports || []).length + 1;
		  	},
		  	sortedTeams: function() {
		  		var standings = this.league_info.standings || {};
		  		return this.teams.slice().sort(function(a, b) {
		  			var sa = standings[a.id] || { wins: 0 };
		  			var sb = standings[b.id] || { wins: 0 };
		  			return sb.wins - sa.wins;
		  		});
		  	}
		  }
		})

		app.fetchDraftData();
		if(league.status == "In Progress") {
			setInterval(app.fetchDraftData, 1000 * 5)
		}

		if(league.status != "Completed") {
			setInterval(app.fetchData, 1000 * 10)
		}