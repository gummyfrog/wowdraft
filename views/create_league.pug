extends layout

block content
	div#content.create-league-page
		div.create-league-layout

			//- Left Column: Form
			div.create-league-form
				h1.create-league-title
					i.fas.fa-plus-circle
					|  Create a League

				form.create-league-sections(action='/leagues/api/create' method='post')

					//- Section: Identity
					div.form-section
						div.form-section-head
							i.fas.fa-id-card
							span  Identity
						div.form-section-body
							label.form-label League Name
							input.form-input(v-model="name" type='text' placeholder="Lion's Pride Inn League" name='name' required)

							label.form-label Description
							input.form-input(v-model="description" type='text' placeholder='Describe your League here!' name='description' required)

							label.form-label Icon
							div.icon-grid
								div.icon-grid-item(
									v-for="ic in allIcons"
									:class="{ active: icon === ic }"
									@click="icon = ic"
								)
									img(:src="'/images/league_icons/' + ic" :alt="ic")
							input(type='hidden' name='icon' :value="icon")

							label.form-label Primary Color
							div.color-picker-row
								input.form-color(type="color" v-model="color1" name="color1" required)
								span.color-hex {{color1}}

							label.form-label Game Version
							select.form-input(v-model="game_version" name="game_version" required)
								option(value="retail") Retail (The War Within)
								option(value="classic") Classic

							label.form-label Region
							select.form-input(v-model="region" name="region" required)
								option(value="us") US
								option(value="eu") EU
								option(value="kr") KR
								option(value="tw") TW

					//- Section: Draft Settings
					div.form-section
						div.form-section-head
							i.fas.fa-cogs
							span  Draft Settings
						div.form-section-body

							label.form-label Roster Requirements
							div.roster-req-row
								div.roster-req-field
									label.roster-req-label Tanks
									input.form-input.form-input--small(v-model.number="req_tanks" type='number' name='req_tanks' min="0" max="10")
								div.roster-req-field
									label.roster-req-label Healers
									input.form-input.form-input--small(v-model.number="req_healers" type='number' name='req_healers' min="0" max="10")
								div.roster-req-field
									label.roster-req-label DPS
									input.form-input.form-input--small(v-model.number="req_dps" type='number' name='req_dps' min="0" max="10")
							div.roster-req-total {{totalRequired}} required · {{rounds - totalRequired > 0 ? (rounds - totalRequired) + ' flex picks' : 'no flex picks'}}
							div.roster-req-total.roster-req-warning(v-if="rounds < totalRequired") Rounds can't be less than {{totalRequired}} — auto-adjusting.

							label.form-label Rounds (picks per team)
							input.form-input(v-model.number="rounds" type='number' placeholder='10' name='rounds' :min="totalRequired" max="15" required)

							label.form-label Season Length (weeks)
							input.form-input(v-model="season_length" type='number' placeholder='8' name='season_length' min="2" max="20" required)

							label.form-label Draft Notes (optional)
							input.form-input(v-model="draft_notes" type="text" name="draft_notes" placeholder="e.g. Next Monday at 4pm, Discord voice channel #draft")

							div.reminder-box
								h4.reminder-box-title
									i.fas.fa-exclamation-circle
									|  Remember!
								p.reminder-box-text You, as the organizer, need to start the draft manually. Draft notes are just for communicating plans to your league.

					//- Section: Guilds
					div.form-section
						div.form-section-head
							i.fas.fa-users
							span  Guilds
						div.form-section-body
							div.guild-chips(v-if="selectedGuilds.length > 0")
								span.guild-chip(v-for="(g, i) in selectedGuilds")
									| {{g}}
									button.guild-chip-x(type='button' @click="removeGuild(i)") ×
							label.form-label Search Guilds
							input.form-input(v-model="guildFilter" type='text' placeholder='Filter guilds...')
							div.guild-results(v-if="filteredGuilds.length > 0")
								div.guild-result-item(v-for="g in filteredGuilds" @click="addGuild(g.name)" :class="{ disabled: selectedGuilds.includes(g.name) }")
									span {{g.name}}
									span.guild-result-check(v-if="selectedGuilds.includes(g.name)")  ✓
							div.guild-results(v-else-if="allGuilds.length === 0")
								span.guild-loading Loading guilds...
							input(type='hidden' name='guilds' :value="selectedGuilds.join(',')")

					//- Section: Schedule
					div.form-section
						div.form-section-head
							i.fas.fa-calendar-alt
							span  Schedule
						div.form-section-body
							label.form-label Raids
							div.raid-pills
								label.raid-pill(v-for="zone in availableZones" :class="{ active: selectedRaidIds.includes(zone.id) }")
									input(type='checkbox' :value="zone.id" v-model="selectedRaidIds")
									span {{zone.name}}
							input(type='hidden' name='raids' :value="JSON.stringify(selectedRaids)")

							label.form-label Activity Report Day
							select.form-input(v-model="report_day" name="report_day")
								option(value="Sunday") Sunday
								option(value="Monday") Monday
								option(value="Tuesday") Tuesday
								option(value="Wednesday") Wednesday
								option(value="Thursday") Thursday
								option(value="Friday") Friday
								option(value="Saturday") Saturday

					//- Submit
					button.btn-styled.btn-styled--primary.btn-large(type='submit')
						i.fas.fa-check
						|  Create League

			//- Right Column: Live Preview
			div.create-league-preview
				div.preview-sticky
					h3.preview-label Live Preview
					div.league-card
						div.league-card-banner(:style="'background: linear-gradient(135deg, ' + color1 + '44, ' + color1 + '11)'")
						div.league-card-body
							div.league-card-top
								img(:src="'/images/league_icons/' + icon")
								h2(:style="'color:'+color1") {{name}}
								span.status-badge.setting-up Setting Up
							div.league-card-meta
								span {{game_version === 'classic' ? 'Classic' : 'Retail'}}
								span ·
								span {{region.toUpperCase()}}
								span ·
								span Snake Draft
							div.league-card-footer
								span {{rounds}} rounds · {{season_length}} weeks
								span {{region.toUpperCase()}}

	script.
		var app = new Vue({
			el: '#content',
			data: {
				name:"Stormwind League",
				description: "Light be with you.",
				rounds: 10,
				game_version: "retail",
				region: "us",
				season_length: 8,
				style:"Standard",
				color1: "#0070FF",
				icon: "banner_Human.png",
				report_day: "Tuesday",
				draft_notes: "",
				req_tanks: 2,
				req_healers: 3,
				req_dps: 5,
				guildFilter: "",
				allGuilds: [],
				selectedGuilds: [],
				selectedRaidIds: [],
				allIcons: [
					"banner_Bloodelf.png",
					"banner_Draenei.png",
					"banner_Dwarf.png",
					"banner_Gnome.png",
					"banner_Human.png",
					"banner_Nightelf.png",
					"banner_Orc.png",
					"banner_Scourge.png",
					"banner_Tauren.png",
					"banner_Troll.png",
					"Symbol_BloodElf.png",
					"Symbol_Brewfest.png",
					"Symbol_Draenei.png",
					"Symbol_Dwarf.png",
					"Symbol_Gnome.png",
					"Symbol_Human.png",
					"Symbol_NightElf.png",
					"Symbol_Orc.png",
					"Symbol_Scourge.png",
					"Symbol_Tauren.png",
					"Symbol_Troll.png",
					"Tabard_BloodElf.png",
					"Tabard_Draenei.png",
					"Tabard_Dwarf.png",
					"Tabard_gnome.png",
					"Tabard_Human.png",
					"Tabard_NightElf.png",
					"Tabard_Orc.png",
					"Tabard_scourge.png",
					"Tabard_Tauren.png",
					"Tabard_Troll.png",
				],
			},
			methods: {
				fetchGuilds: function() {
					var self = this;
					fetch('/leagues/api/guilds/search?region=' + this.region + '&game_version=' + this.game_version)
						.then(function(res) { return res.json(); })
						.then(function(guilds) { self.allGuilds = guilds; });
				},
				addGuild: function(name) {
					if (this.selectedGuilds.length >= 5) return;
					if (!this.selectedGuilds.includes(name)) {
						this.selectedGuilds.push(name);
					}
				},
				removeGuild: function(index) {
					this.selectedGuilds.splice(index, 1);
				},
			},
			computed: {
				totalRequired: function() {
					return (this.req_tanks || 0) + (this.req_healers || 0) + (this.req_dps || 0);
				},
				filteredGuilds: function() {
					var filter = this.guildFilter.toLowerCase();
					if (!filter) return this.allGuilds;
					return this.allGuilds.filter(function(g) {
						return g.name.toLowerCase().indexOf(filter) !== -1;
					});
				},
				availableZones: function() {
					var zones = {
						classic: [
							{ id: 1000, name: 'Molten Core' },
							{ id: 1001, name: "Onyxia's Lair" },
							{ id: 1002, name: 'Blackwing Lair' },
							{ id: 1003, name: "Zul'Gurub" },
							{ id: 1004, name: "Temple of Ahn'Qiraj" },
							{ id: 1005, name: "Ruins of Ahn'Qiraj" },
							{ id: 1006, name: 'Naxxramas' },
						],
						retail: [
							{ id: 38, name: "Nerub'ar Palace" },
							{ id: 37, name: 'Amirdrassil' },
						],
					};
					return zones[this.game_version] || zones.retail;
				},
				selectedRaids: function() {
					return this.availableZones.filter(z => this.selectedRaidIds.includes(z.id));
				},
			},
			watch: {
				game_version: function() {
					this.selectedRaidIds = this.availableZones.map(z => z.id);
					this.fetchGuilds();
				},
				region: function() { this.fetchGuilds(); },
				totalRequired: function(val) {
					if (this.rounds < val) this.rounds = val;
				},
			},
			mounted: function() {
				this.selectedRaidIds = this.availableZones.map(z => z.id);
				this.fetchGuilds();
			},
		})
