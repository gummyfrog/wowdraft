extends layout

block content
	div#content.create-league-page
		div.create-league-layout

			//- Left Column: Form
			div.create-league-form
				h1.create-league-title
					i.fas.fa-plus-circle
					|  Create a League

				form.create-league-sections(action='/leagues/api/create' method='post')

					//- Section: Identity
					div.form-section
						div.form-section-head
							i.fas.fa-id-card
							span  Identity
						div.form-section-body
							label.form-label League Name
							input.form-input(v-model="name" type='text' placeholder="Lion's Pride Inn League" name='name' required)

							label.form-label Description
							input.form-input(v-model="description" type='text' placeholder='Describe your League here!' name='description' required)

							label.form-label Icon
							div.icon-grid
								div.icon-grid-item(
									v-for="ic in allIcons"
									:class="{ active: icon === ic }"
									@click="icon = ic"
								)
									img(:src="'/images/league_icons/' + ic" :alt="ic")
							input(type='hidden' name='icon' :value="icon")

							label.form-label Primary Color
							div.color-picker-row
								input.form-color(type="color" v-model="color1" name="color1" required)
								span.color-hex {{color1}}

							label.form-label Game Version
							div.form-field-row
								select.form-input(v-model="game_version" name="game_version" required)
									option(v-for="gv in gameVersions" :value="gv.id") {{gv.name}}

							label.form-label Region
							div.form-field-row
								select.form-input(v-model="region" name="region" :disabled="loadingRegions || regions.length === 0" required)
									option(v-if="loadingRegions" value="" disabled) Loading...
									option(v-for="r in regions" :value="r.slug") {{r.name}}
								span.field-spinner(v-if="loadingRegions")
									span.loading-spinner.loading-spinner--inline
							input(type='hidden' name='region_id' :value="region_id")

							label.form-label Server / Realm
							div.form-field-row
								select.form-input(v-model="server" name="server" :disabled="loadingServers || servers.length === 0" required)
									option(v-if="loadingServers" value="" disabled) Loading...
									option(v-if="!loadingServers && servers.length === 0" value="" disabled) Select a region first
									option(v-for="s in servers" :value="s.slug") {{s.name}}
								span.field-spinner(v-if="loadingServers")
									span.loading-spinner.loading-spinner--inline
							input(type='hidden' name='server_id' :value="server_id")

					//- Section: Draft Settings
					div.form-section
						div.form-section-head
							i.fas.fa-cogs
							span  Draft Settings
						div.form-section-body

							label.form-label Roster Requirements
							div.roster-req-row
								div.roster-req-field
									label.roster-req-label Tanks
									input.form-input.form-input--small(v-model.number="req_tanks" type='number' name='req_tanks' min="0" max="10")
								div.roster-req-field
									label.roster-req-label Healers
									input.form-input.form-input--small(v-model.number="req_healers" type='number' name='req_healers' min="0" max="10")
								div.roster-req-field
									label.roster-req-label DPS
									input.form-input.form-input--small(v-model.number="req_dps" type='number' name='req_dps' min="0" max="10")
							div.roster-req-total {{totalRequired}} required · {{rounds - totalRequired > 0 ? (rounds - totalRequired) + ' flex picks' : 'no flex picks'}}
							div.roster-req-total.roster-req-warning(v-if="rounds < totalRequired") Rounds can't be less than {{totalRequired}} — auto-adjusting.

							label.form-label Rounds (picks per team)
							input.form-input(v-model.number="rounds" type='number' placeholder='10' name='rounds' :min="totalRequired" max="15" required)

							label.form-label Season Length (weeks)
							input.form-input(v-model="season_length" type='number' placeholder='8' name='season_length' min="2" max="20" required)

							label.form-label Draft Notes (optional)
							input.form-input(v-model="draft_notes" type="text" name="draft_notes" placeholder="e.g. Next Monday at 4pm, Discord voice channel #draft")

							div.reminder-box
								h4.reminder-box-title
									i.fas.fa-exclamation-circle
									|  Remember!
								p.reminder-box-text You, as the organizer, need to start the draft manually. Draft notes are just for communicating plans to your league.

					//- Section: Guilds
					div.form-section
						div.form-section-head
							i.fas.fa-users
							span  Guilds
						div.form-section-body
							div.guild-chips(v-if="selectedGuilds.length > 0")
								span.guild-chip(v-for="(g, i) in selectedGuilds")
									| {{g.name}}
									span.guild-chip-faction(v-if="g.faction")  ({{g.faction}})
									button.guild-chip-x(type='button' @click="removeGuild(i)") ×
							label.form-label Search Guilds
							input.form-input(v-model="guildFilter" type='text' placeholder='Filter guilds...' :disabled="!server && servers.length > 0")
							div.guild-results(v-if="filteredGuilds.length > 0")
								div.guild-result-item(v-for="g in filteredGuilds" @click="addGuild(g)" :class="{ disabled: isGuildSelected(g.name) }")
									span {{g.name}}
									span.guild-result-faction(v-if="g.faction")  · {{g.faction}}
									span.guild-result-check(v-if="isGuildSelected(g.name)")  ✓
							div.guild-results(v-else-if="loadingGuilds")
								span.guild-loading
									span.loading-spinner.loading-spinner--inline
									|  Loading guilds...
							div.guild-results(v-else-if="server && allGuilds.length === 0 && !loadingGuilds")
								span.guild-loading No guilds found for this server.
							input(type='hidden' name='guilds' :value="JSON.stringify(selectedGuilds)")

					//- Section: Schedule
					div.form-section
						div.form-section-head
							i.fas.fa-calendar-alt
							span  Schedule
						div.form-section-body
							label.form-label Raids
							div.raid-pills(v-if="!loadingZones && availableZones.length > 0")
								label.raid-pill(v-for="zone in availableZones" :class="{ active: selectedRaidIds.includes(zone.id) }")
									input(type='checkbox' :value="zone.id" v-model="selectedRaidIds")
									span {{zone.name}}
							div.raid-pills(v-else-if="loadingZones")
								span.field-spinner
									span.loading-spinner.loading-spinner--inline
									|  Loading raids...
							input(type='hidden' name='raids' :value="JSON.stringify(selectedRaids)")

							label.form-label Activity Report Day
							select.form-input(v-model="report_day" name="report_day")
								option(value="Sunday") Sunday
								option(value="Monday") Monday
								option(value="Tuesday") Tuesday
								option(value="Wednesday") Wednesday
								option(value="Thursday") Thursday
								option(value="Friday") Friday
								option(value="Saturday") Saturday

					//- Submit
					button.btn-styled.btn-styled--primary.btn-large(type='submit')
						i.fas.fa-check
						|  Create League

			//- Right Column: Live Preview
			div.create-league-preview
				div.preview-sticky
					h3.preview-label Live Preview
					div.league-card
						div.league-card-banner(:style="'background: linear-gradient(135deg, ' + color1 + '44, ' + color1 + '11)'")
						div.league-card-body
							div.league-card-top
								img(:src="'/images/league_icons/' + icon")
								h2(:style="'color:'+color1") {{name}}
								span.status-badge.setting-up Setting Up
							div.league-card-meta
								span {{gameVersionName}}
								span ·
								span {{regionName}}
								span ·
								span Snake Draft
							div.league-card-footer
								span {{rounds}} rounds · {{season_length}} weeks
								span(v-if="serverName") {{serverName}}

	script.
		var app = new Vue({
			el: '#content',
			data: {
				name: "Stormwind League",
				description: "Light be with you.",
				rounds: 10,
				game_version: "retail",
				region: "",
				region_id: null,
				server: "",
				server_id: null,
				season_length: 8,
				color1: "#0070FF",
				icon: "banner_Human.png",
				report_day: "Tuesday",
				draft_notes: "",
				req_tanks: 2,
				req_healers: 3,
				req_dps: 5,
				guildFilter: "",
				allGuilds: [],
				selectedGuilds: [],
				selectedRaidIds: [],
				gameVersions: [],
				regions: [],
				servers: [],
				availableZones: [],
				loadingRegions: false,
				loadingServers: false,
				loadingZones: false,
				loadingGuilds: false,
				allIcons: [
					"banner_Bloodelf.png",
					"banner_Draenei.png",
					"banner_Dwarf.png",
					"banner_Gnome.png",
					"banner_Human.png",
					"banner_Nightelf.png",
					"banner_Orc.png",
					"banner_Scourge.png",
					"banner_Tauren.png",
					"banner_Troll.png",
					"Symbol_BloodElf.png",
					"Symbol_Brewfest.png",
					"Symbol_Draenei.png",
					"Symbol_Dwarf.png",
					"Symbol_Gnome.png",
					"Symbol_Human.png",
					"Symbol_NightElf.png",
					"Symbol_Orc.png",
					"Symbol_Scourge.png",
					"Symbol_Tauren.png",
					"Symbol_Troll.png",
					"Tabard_BloodElf.png",
					"Tabard_Draenei.png",
					"Tabard_Dwarf.png",
					"Tabard_gnome.png",
					"Tabard_Human.png",
					"Tabard_NightElf.png",
					"Tabard_Orc.png",
					"Tabard_scourge.png",
					"Tabard_Tauren.png",
					"Tabard_Troll.png",
				],
			},
			methods: {
				fetchGameVersions: function() {
					var self = this;
					fetch('/leagues/api/game-versions')
						.then(function(res) { return res.json(); })
						.then(function(versions) { self.gameVersions = versions; });
				},
				fetchRegions: function() {
					var self = this;
					self.loadingRegions = true;
					fetch('/leagues/api/regions?game_version=' + this.game_version)
						.then(function(res) { return res.json(); })
						.then(function(regions) {
							self.regions = regions;
							self.loadingRegions = false;
							// Auto-select first region if none selected
							if (!self.region && regions.length > 0) {
								self.region = regions[0].slug;
								self.region_id = regions[0].id;
							}
						})
						.catch(function() { self.loadingRegions = false; });
				},
				fetchServers: function() {
					var self = this;
					if (!self.region_id) {
						self.servers = [];
						return;
					}
					self.loadingServers = true;
					fetch('/leagues/api/servers?region_id=' + this.region_id + '&game_version=' + this.game_version)
						.then(function(res) { return res.json(); })
						.then(function(servers) {
							self.servers = servers;
							self.loadingServers = false;
						})
						.catch(function() { self.loadingServers = false; });
				},
				fetchZones: function() {
					var self = this;
					self.loadingZones = true;
					fetch('/leagues/api/zones?game_version=' + this.game_version)
						.then(function(res) { return res.json(); })
						.then(function(zones) {
							self.availableZones = zones;
							self.selectedRaidIds = zones.map(function(z) { return z.id; });
							self.loadingZones = false;
						})
						.catch(function() { self.loadingZones = false; });
				},
				fetchGuilds: function() {
					var self = this;
					var serverSlug = this.server;
					self.loadingGuilds = true;
					var url = '/leagues/api/guilds/search?region=' + this.region + '&game_version=' + this.game_version;
					if (serverSlug) url += '&server=' + encodeURIComponent(serverSlug);
					fetch(url)
						.then(function(res) { return res.json(); })
						.then(function(guilds) {
							self.allGuilds = guilds;
							self.loadingGuilds = false;
						})
						.catch(function() { self.loadingGuilds = false; });
				},
				addGuild: function(guild) {
					if (this.selectedGuilds.length >= 5) return;
					if (!this.isGuildSelected(guild.name)) {
						this.selectedGuilds.push({ name: guild.name, faction: guild.faction || null });
					}
				},
				isGuildSelected: function(name) {
					return this.selectedGuilds.some(function(g) { return g.name === name; });
				},
				removeGuild: function(index) {
					this.selectedGuilds.splice(index, 1);
				},
			},
			computed: {
				totalRequired: function() {
					return (this.req_tanks || 0) + (this.req_healers || 0) + (this.req_dps || 0);
				},
				filteredGuilds: function() {
					var filter = this.guildFilter.toLowerCase();
					if (!filter) return this.allGuilds;
					return this.allGuilds.filter(function(g) {
						return g.name.toLowerCase().indexOf(filter) !== -1;
					});
				},
				selectedRaids: function() {
					var self = this;
					return this.availableZones.filter(function(z) {
						return self.selectedRaidIds.includes(z.id);
					});
				},
				gameVersionName: function() {
					var self = this;
					var gv = this.gameVersions.find(function(v) { return v.id === self.game_version; });
					return gv ? gv.name : this.game_version;
				},
				regionName: function() {
					var self = this;
					var r = this.regions.find(function(reg) { return reg.slug === self.region; });
					return r ? r.name : this.region.toUpperCase();
				},
				serverName: function() {
					var self = this;
					var s = this.servers.find(function(srv) { return srv.slug === self.server; });
					return s ? s.name : '';
				},
			},
			watch: {
				game_version: function() {
					// Reset all downstream selections
					this.region = "";
					this.region_id = null;
					this.server = "";
					this.server_id = null;
					this.servers = [];
					this.selectedGuilds = [];
					this.allGuilds = [];
					this.selectedRaidIds = [];
					this.availableZones = [];
					this.fetchRegions();
					this.fetchZones();
				},
				region: function(val) {
					// Find region_id from the regions list
					var self = this;
					var r = this.regions.find(function(reg) { return reg.slug === val; });
					this.region_id = r ? r.id : null;
					// Reset downstream
					this.server = "";
					this.server_id = null;
					this.selectedGuilds = [];
					this.allGuilds = [];
					if (this.region_id) {
						this.fetchServers();
					} else {
						this.servers = [];
					}
				},
				server: function(val) {
					// Find server_id from the servers list
					var self = this;
					var s = this.servers.find(function(srv) { return srv.slug === val; });
					this.server_id = s ? s.id : null;
					// Reset guilds and re-fetch
					this.selectedGuilds = [];
					this.allGuilds = [];
					if (val) {
						this.fetchGuilds();
					}
				},
				totalRequired: function(val) {
					if (this.rounds < val) this.rounds = val;
				},
			},
			mounted: function() {
				this.fetchGameVersions();
				this.fetchRegions();
				this.fetchZones();
			},
		})
