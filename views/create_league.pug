extends layout

block content
	div#content
		div.title-bar
				h2 Please Enter...

		form.makeLeague(action='/leagues/api/create' method='post')
			h3 A name for your League:
			input(v-model="name" type='text' placeholder="Lion's Pride Inn League" name='name' required)

			h3 A short blurb for your League:
			input(v-model="description" type='text' placeholder='Describe your League here!' name='description' required)

			h3 Customization:
			select(name="icon" v-model="icon" required)
				option(value="banner_Bloodelf.png") Bloodelf Banner
				option(value="banner_Draenei.png") Draenei Banner
				option(value="banner_Dwarf.png") Dwarf Banner
				option(value="banner_Gnome.png") Gnome Banner
				option(value="banner_Human.png") Human Banner
				option(value="banner_Nightelf.png") Night Elf Banner
				option(value="banner_Orc.png") Orc Banner
				option(value="banner_Scourge.png") Scourge Banner
				option(value="banner_Tauren.png") Tauren Banner
				option(value="banner_Troll.png") Troll Banner
				option(value="Symbol_Brewfest.png") Brewfest

			img.preview_logo( :src="'/images/league_icons/' + icon")

			input(type="color" v-model="color1" name="color1" required)

			h3 # of Rounds (picks) per player:
			input(v-model="rounds" type='number' placeholder='10' name='rounds' min="1" max="10" required)

			h3 Game Version:
			select(v-model="game_version" name="game_version" required)
				option(value="retail") Retail (The War Within)
				option(value="classic") Classic

			h3 Server:
			input(v-model="server" type='text' placeholder='Faerlina' name='server' required)

			h3 Region:
			select(v-model="region" name="region" required)
				option(value="us") US
				option(value="eu") EU
				option(value="kr") KR
				option(value="tw") TW

			h3 Faction:
			select(v-model="faction" name="faction" required)
				option(value="Alliance") Alliance
				option(value="Horde") Horde

			h3 Season Length (weeks):
			input(v-model="season_length" type='number' placeholder='8' name='season_length' min="2" max="20" required)

			h3 Guilds:
			div.guild_search
				input(v-model="guildSearch" type='text' placeholder='Search for a guild...' @keyup.enter="searchGuilds")
				button(type='button' @click="searchGuilds") Search
			div.guild_results(v-if="guildResults.length > 0")
				div.guild_result(v-for="g in guildResults" @click="addGuild(g.name)")
					span {{g.name}}
					span.guild_faction(v-if="g.faction")  ({{g.faction}})
			div.selected_guilds
				div.selected_guild(v-for="(g, i) in selectedGuilds")
					span {{g}}
					button(type='button' @click="removeGuild(i)") x
			input(type='hidden' name='guilds' :value="selectedGuilds.join(',')")

			h3 Raids:
			div.raid_selection
				label(v-for="zone in availableZones")
					input(type='checkbox' :value="zone.id" v-model="selectedRaidIds")
					span  {{zone.name}}
			input(type='hidden' name='raids' :value="JSON.stringify(selectedRaids)")

			h3 Activity Report Day
			select(v-model="report_day" name="report_day")
				option(value="Sunday") Sunday
				option(value="Monday") Monday
				option(value="Tuesday") Tuesday
				option(value="Wednesday") Wednesday
				option(value="Thursday") Thursday
				option(value="Friday") Friday
				option(value="Saturday") Saturday

			h3 Proposed Draft Start Date/Time


			input(v-model="start_date" type="text" name="start_date" placeholder="Next Monday at 4pm!")

			div.reminder
				h4. 
					<i class="fas fa-exclamation-circle"></i> Remember!
					You, as the organizer, need to start the draft manually.
				h4 This is just for scheduling, so be informative (and on time!)


			h3
				button(type='submit').
					<i class="fas fa-check"></i> 
					All Done!

		h1 Preview:

		div(:style="'color:'+color1").league_wrapper
			img.league_logo( :src="'/images/league_icons/' + icon")
			h1.league_name {{name}}
			h4.flavor {{description}}

	script.
		var app = new Vue({
			el: '#content',
			data: {
				name:"Stormwind League",
				description: "Light be with you.",
				rounds: 10,
				game_version: "retail",
				server: "",
				region: "us",
				faction: "Alliance",
				season_length: 8,
				style:"Standard",
				color1: "#0070FF",
				icon: "banner_Human.png",
				report_day: "Tuesday",
				start_date: "next monday at 3pm",
				guildSearch: "",
				guildResults: [],
				selectedGuilds: [],
				selectedRaidIds: [],
			},
			methods: {
				searchGuilds: function() {
					if (!this.guildSearch) return;
					fetch('/leagues/api/guilds/search?q=' + encodeURIComponent(this.guildSearch) + '&server=' + encodeURIComponent(this.server) + '&region=' + this.region + '&game_version=' + this.game_version)
						.then(function(res) { return res.json(); })
						.then(function(guilds) { app.guildResults = guilds; });
				},
				addGuild: function(name) {
					if (this.selectedGuilds.length >= 5) return;
					if (!this.selectedGuilds.includes(name)) {
						this.selectedGuilds.push(name);
					}
					this.guildResults = [];
					this.guildSearch = "";
				},
				removeGuild: function(index) {
					this.selectedGuilds.splice(index, 1);
				},
			},
			computed: {
				availableZones: function() {
					var zones = {
						classic: [
							{ id: 1000, name: 'Molten Core' },
							{ id: 1001, name: "Onyxia's Lair" },
							{ id: 1002, name: 'Blackwing Lair' },
							{ id: 1003, name: "Zul'Gurub" },
							{ id: 1004, name: "Temple of Ahn'Qiraj" },
							{ id: 1005, name: "Ruins of Ahn'Qiraj" },
							{ id: 1006, name: 'Naxxramas' },
						],
						retail: [
							{ id: 38, name: "Nerub'ar Palace" },
							{ id: 37, name: 'Amirdrassil' },
						],
					};
					return zones[this.game_version] || zones.retail;
				},
				selectedRaids: function() {
					return this.availableZones.filter(z => this.selectedRaidIds.includes(z.id));
				},
			},
			watch: {
				game_version: function() {
					this.selectedRaidIds = this.availableZones.map(z => z.id);
				},
			},
			mounted: function() {
				this.selectedRaidIds = this.availableZones.map(z => z.id);
			},
		})