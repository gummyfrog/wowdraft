extends layout

block content
	div#league_rankings
		div#content

			draft_info(
				v-bind:league_info="league_info",
				v-bind:status_slug="statusSlug",
				v-bind:is_admin="organizer",
				current_page="rankings"
			)

			div(v-if="activity_report != null")#report_wrapper

				div.week-selector
					button(@click="prevWeek" :disabled="selectedWeek <= 0")
						i.fas.fa-arrow-left
					h1.activity_header.
						<i class="fas fa-calendar"></i>
						Week {{selectedWeek + 1}} Activity Report
					button(@click="nextWeek" :disabled="selectedWeek >= activity_reports.length - 1")
						i.fas.fa-arrow-right

				details.scoring-legend
					summary
						i.fas.fa-info-circle
						|  How scoring works
					ul.legend-list
						li
							span.legend-cat Parse Performance
							span.legend-max max 10
							span.legend-desc Average best parse percentile across all bosses. ≥99 → 10, ≥95 → 8, ≥90 → 6, ≥75 → 4, ≥50 → 2, anything lower → 1.
						li
							span.legend-cat DPS Ranking
							span.legend-max max 8
							span.legend-desc Average best DPS ranked against every other drafted player. Percentile ≥0.95 → 8, ≥0.80 → 6, ≥0.60 → 4, ≥0.40 → 2, lower → 1.
						li
							span.legend-cat Bosses Down
							span.legend-max max 10
							span.legend-desc Kills gained since last week's snapshot. 2 points per new kill, capped at 10.
						li
							span.legend-cat Speedy Clear
							span.legend-max max 8
							span.legend-desc Bosses where you hold the fastest kill time in the league. 2 points each, capped at 8.
						li
							span.legend-cat New Best
							span.legend-max max 8
							span.legend-desc Every boss where your parse percentile or best DPS beat the previous snapshot. 1 point each, capped at 8.
						li
							span.legend-cat Consistency
							span.legend-max max 6
							span.legend-desc Average median-percent ÷ best-percent ratio. ≥0.95 → 6, ≥0.85 → 4, ≥0.70 → 2, lower → 1.
						li
							span.legend-cat All-Star
							span.legend-max max 6
							span.legend-desc Zone All-Star points ÷ possible points. ≥0.80 → 6, ≥0.60 → 4, ≥0.40 → 2, above zero → 1.

				team-item(
					v-for="(team, index) in sorted_teams"
					v-bind:team="team",
					v-bind:team_index="index",
					v-bind:activity_report="activity_report",
					v-bind:total_points="total_points",
					v-bind:get_index="getIndex",
					v-bind:highest_points="highestPoints",
				)
			div(v-if="activity_report && activity_report.matchups").matchups-section
				div.title-bar
					h2.
						<i class="fas fa-trophy"></i>
						Matchup Results
				div.matchups-container
					div(v-for="m in activity_report.matchups")
						div(v-if="m.bye").matchup-bye
							| {{getTeamName(m.bye)}} — Bye Week
						div(v-else).matchup-card
							div.matchup-team.home(:class="{winner: m.winner === m.home}")
								div.matchup-winner-banner(v-if="m.winner === m.home && getTeamData(m.home)")
									div.team-banner.team-banner--sm(:class="'team-banner--' + (getTeamData(m.home).banner_shape || 'pointed')" :style="'--ban-bg:' + (getTeamData(m.home).banner_bg || getTeamData(m.home).color2 || '#555') + '; --ban-accent:' + (getTeamData(m.home).banner_accent || '#FFD100')")
										div.team-banner-bg(:class="'pat-' + (getTeamData(m.home).banner_pattern || 'solid')" :style="'background-color:' + (getTeamData(m.home).banner_bg || getTeamData(m.home).color2 || '#555')")
										div.team-banner-emblem(:style="'color:' + (getTeamData(m.home).banner_emblem_color || '#fff')")
											i(:class="'fas fa-' + (getTeamData(m.home).banner_emblem || 'shield-alt')")
								span.matchup-team-name {{getTeamName(m.home)}}
								img(:src="getTeamIcon(m.home)")
							div.matchup-score
								span.matchup-vs VS
								div.matchup-score-numbers {{m.homeScore}} - {{m.awayScore}}
								div(v-if="m.winner").matchup-result {{getTeamName(m.winner)}} wins!
								div(v-if="m.tie").matchup-result Tie!
							div.matchup-team.away(:class="{winner: m.winner === m.away}")
								div.matchup-winner-banner(v-if="m.winner === m.away && getTeamData(m.away)")
									div.team-banner.team-banner--sm(:class="'team-banner--' + (getTeamData(m.away).banner_shape || 'pointed')" :style="'--ban-bg:' + (getTeamData(m.away).banner_bg || getTeamData(m.away).color2 || '#555') + '; --ban-accent:' + (getTeamData(m.away).banner_accent || '#FFD100')")
										div.team-banner-bg(:class="'pat-' + (getTeamData(m.away).banner_pattern || 'solid')" :style="'background-color:' + (getTeamData(m.away).banner_bg || getTeamData(m.away).color2 || '#555')")
										div.team-banner-emblem(:style="'color:' + (getTeamData(m.away).banner_emblem_color || '#fff')")
											i(:class="'fas fa-' + (getTeamData(m.away).banner_emblem || 'shield-alt')")
								img(:src="getTeamIcon(m.away)")
								span.matchup-team-name {{getTeamName(m.away)}}

			div.empty-state(v-else)
				i.fas.fa-chart-bar.empty-state-icon
				p.empty-state-message Waiting on report to be generated
				p.empty-state-subtext Rankings will appear here after the first activity report is generated.

			div(v-if="activity_reports.length > 0").bracket-section
				div.title-bar
					h2.
						<i class="fas fa-sitemap"></i>
						Season Bracket
				div.bracket-container
					div.bracket-weeks
						div(v-for="(report, weekIndex) in activity_reports" :key="weekIndex").bracket-week
							div.bracket-week-label Week {{weekIndex + 1}}
							div(v-if="report.matchups")
								div(v-for="m in report.matchups" :key="m.home || m.bye")
									div(v-if="m.bye").bracket-matchup
										div.bracket-bye {{getTeamName(m.bye)}} — Bye
									div(v-else).bracket-matchup
										div.bracket-team-row(:class="{'bracket-winner': m.winner === m.home}")
											div.bracket-banner-mini(v-if="m.winner === m.home && getTeamData(m.home)")
												div.team-banner(:class="'team-banner--' + (getTeamData(m.home).banner_shape || 'pointed')" :style="'width:16px; height:20px; --ban-bg:' + (getTeamData(m.home).banner_bg || '#555') + '; --ban-accent:' + (getTeamData(m.home).banner_accent || '#FFD100')")
													div.team-banner-bg(:class="'pat-' + (getTeamData(m.home).banner_pattern || 'solid')" :style="'background-color:' + (getTeamData(m.home).banner_bg || '#555')")
											span.bracket-team-name {{getTeamName(m.home)}}
											span.bracket-team-score {{m.homeScore}}
										div.bracket-team-row(:class="{'bracket-winner': m.winner === m.away}")
											div.bracket-banner-mini(v-if="m.winner === m.away && getTeamData(m.away)")
												div.team-banner(:class="'team-banner--' + (getTeamData(m.away).banner_shape || 'pointed')" :style="'width:16px; height:20px; --ban-bg:' + (getTeamData(m.away).banner_bg || '#555') + '; --ban-accent:' + (getTeamData(m.away).banner_accent || '#FFD100')")
													div.team-banner-bg(:class="'pat-' + (getTeamData(m.away).banner_pattern || 'solid')" :style="'background-color:' + (getTeamData(m.away).banner_bg || '#555')")
											span.bracket-team-name {{getTeamName(m.away)}}
											span.bracket-team-score {{m.awayScore}}
							div(v-else)
								div.bracket-matchup
									div.bracket-bye Pending...

	script.
		var league = !{JSON.stringify(league)}
		league = JSON.parse(league)

		var SCORE_CATEGORIES = [
			{ key: 'parse', label: 'Parse Performance' },
			{ key: 'dps', label: 'DPS Ranking' },
			{ key: 'bosses_down', label: 'Bosses Down' },
			{ key: 'speedy_clear', label: 'Speedy Clear' },
			{ key: 'new_best', label: 'New Best' },
			{ key: 'consistency', label: 'Consistency' },
			{ key: 'all_stars', label: 'All-Star' },
		]

		var WCL_BASE = league.game_version === 'classic' ? 'https://classic.warcraftlogs.com' : 'https://www.warcraftlogs.com'
		var WCL_REGION = league.region || 'us'
		var WCL_SERVER = (league.server || '').toLowerCase().replace(/\s/g, '-')

		function characterUrl(name) {
			return WCL_BASE + '/character/' + WCL_REGION + '/' + WCL_SERVER + '/' + encodeURIComponent(name)
		}

		function formatNumber(n) {
			return Number(n).toLocaleString('en-US')
		}

		function pluralize(n, word) {
			return n + ' ' + word + (n === 1 ? '' : 's')
		}

		function detailLine(key, d) {
			if(!d) return ''
			switch(key) {
				case 'parse':
					return d.avg == null ? '' : 'Avg parse ' + d.avg
				case 'dps':
					if(d.avg == null) return ''
					var line = 'Avg DPS ' + formatNumber(d.avg)
					if(d.percentile != null) line += ' — top ' + Math.max(1, Math.round((1 - d.percentile) * 100)) + '%'
					return line
				case 'bosses_down':
					return d.new_kills ? pluralize(d.new_kills, 'new kill') : 'No new kills'
				case 'speedy_clear':
					return d.fastest_bosses ? pluralize(d.fastest_bosses, 'fastest kill') : 'No fastest kills'
				case 'new_best':
					return d.improvements ? pluralize(d.improvements, 'improvement') : 'No improvements'
				case 'consistency':
					return d.ratio == null ? '' : 'Median/best ratio ' + d.ratio
				case 'all_stars':
					if(d.points == null || d.possible == null) return ''
					return 'AS points ' + formatNumber(d.points) + '/' + formatNumber(d.possible)
			}
			return ''
		}

		Vue.component('team-item', {
			props: ['team', 'team_index', 'activity_report', 'total_points', 'get_index', 'highest_points'],
			template: `
			<div class="ranking-card" :style="'border-color:' + (team.color2 || '#555')">
				<div class="ranking-card-head">
					<div v-if="team.banner_shape" class="team-banner team-banner--sm" :class="'team-banner--' + (team.banner_shape || 'pointed')" :style="'--ban-bg:' + (team.banner_bg || team.color2 || '#555') + '; --ban-accent:' + (team.banner_accent || '#FFD100')">
						<div class="team-banner-bg" :class="'pat-' + (team.banner_pattern || 'solid')" :style="'background-color:' + (team.banner_bg || team.color2 || '#555')"></div>
						<div class="team-banner-emblem" :style="'color:' + (team.banner_emblem_color || '#fff')"><i :class="'fas fa-' + (team.banner_emblem || 'shield-alt')"></i></div>
					</div>
					<img :src="'/images/icons/'+team.icon+'.png'">
					<h2 :style="'color:'+team.color2">{{team.name}}</h2>
					<div class="ranking-points">
						<span class="ranking-points-week">{{Math.round(activity_report.data[get_index(team.id)].total_points)}} pts this week</span>
						<span class="ranking-points-total" :style="'color:'+team.color2">
							<i class="fas fa-star"></i> {{total_points(get_index(team.id))}}
						</span>
					</div>
				</div>
				<div class="ranking-roster">
					<mini_player
						v-for="(player, index) in team.drafted_players"
						v-bind:player="player"
						v-bind:team_activity="activity_report.data[get_index(team.id)].players"
						v-bind:index="index"
						v-bind:team_color="team.color2"
						v-bind:highest_points="highest_points">
				</div>
			</div>
			`
		})

		Vue.component('mini_player', {
			props: ['player', 'team_activity', 'team_color', 'highest_points'],
			data: function() {
				return { open: false }
			},
			computed: {
				entry: function() {
					return this.team_activity[this.player.name] || null
				},
				scored: function() {
					return !!(this.entry && this.entry.points && this.entry.points.total > 0)
				},
				wclUrl: function() {
					return characterUrl(this.player.name)
				},
				rows: function() {
					var entry = this.entry
					if(!entry || !entry.points) return []
					var details = entry.details || {}
					return SCORE_CATEGORIES.map(function(c) {
						return {
							key: c.key,
							label: c.label,
							points: entry.points[c.key] || 0,
							detail: detailLine(c.key, details[c.key]),
						}
					})
				},
			},
			template: `
			<div class="ranking-player-wrap">
				<div v-if="scored" class="ranking-player" :class="{expanded: open}" @click="open = !open">
					<img :src="'/images/classes/'+player.class+'.png'">
					<a :href="wclUrl" target="_blank" rel="noopener" :class="'rp-name rp-link '+player.class" @click.stop>{{player.name}}</a>
					<span class="rp-title">{{highest_points(entry.points)}}</span>
					<span class="rp-points" :style="'color:'+team_color">{{entry.points.total}}</span>
					<i class="fas rp-caret" :class="open ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
				</div>
				<div v-else class="ranking-player absent">
					<img :src="'/images/classes/'+player.class+'.png'">
					<a :href="wclUrl" target="_blank" rel="noopener" :class="'rp-name rp-link '+player.class" @click.stop>{{player.name}}</a>
					<span class="rp-points">Absent</span>
				</div>
				<div v-if="open && scored" class="rp-breakdown">
					<div v-for="row in rows" :key="row.key" class="rp-cat">
						<span class="rp-cat-label">{{row.label}}</span>
						<span class="rp-cat-detail">{{row.detail}}</span>
						<span class="rp-cat-points">{{row.points}}</span>
					</div>
				</div>
			</div>
			`
		})


		if(!league.activity_reports) {
			league.activity_reports = [];
		}

		var app = new Vue({
		  el: '#league_rankings',
		  data: {
		  	teams: league.teams,
		  	activity_reports: league.activity_reports,
		  	league_info: league,
		  	organizer: !{organizer},
		  	selectedWeek: league.activity_reports.length > 0 ? league.activity_reports.length - 1 : 0,
		  },
		  computed: {
		  	statusSlug() {
		  		return this.league_info.status.toLowerCase().replace(" ", '-');
		  	},
		  	fancyDate:function() {
		  		if(this.activity_report != null) {
		  			var date = new Date(this.activity_report.time);
		  			return (date.getMonth()+1) + '/' + date.getDate();
		  		}
		  		return '';
		  	},
		  	activity_report:function() {
		  		if(this.activity_reports.length > 0) {
		  			return this.activity_reports[this.selectedWeek];
		  		} else {
		  			return null;
		  		}
		  	},
		  	sorted_teams:function() {
		  		if(this.activity_report == null) return this.teams;
		  		var report = this.activity_report;
		  		var self = this;
		  		return this.teams.slice().sort(function(a, b) {
		  			var ia = self.getIndex(a.id);
		  			var ib = self.getIndex(b.id);
		  			if(ia === -1 || ib === -1) return 0;
		  			return report.data[ib].total_points - report.data[ia].total_points;
		  		});
		  	},
		  },
		  methods: {
		  	total_points:function(team_index) {
		  		var total = 0;
		  		for(var x=0;x<this.activity_reports.length;x++) {
		  			var report = this.activity_reports[x];
		  			total += report.data[team_index].total_points;
		  		}

		  		return Math.round(total);
		  	},
		  	getIndex:function(your_team_id) {
		  		if(this.activity_report != null) {
		  			for(var x=0;x<this.activity_report.data.length;x++) {
		  				var team = this.activity_report.data[x];
		  				if(team.team_id == your_team_id) {
		  					return x;
		  				} 
		  			}
		  		}
		  		return -1;
		  	},
		  	titles:function(highest) {
		  		var msg = "";
		  		switch(highest) {
		  			case("dps"):
		  				msg = "High DPS"
		  				break;
		  			case("parse"):
		  				msg = "Parser"
		  				break;
		  			case("bosses_down"):
		  				msg = "Boss Killer"
		  				break;
		  			case("new_best"):
		  				msg = "Record Setter"
		  				break;
		  			case("speedy_clear"):
		  				msg = "Speed Clearer"
		  				break;
		  			case("consistency"):
		  				msg = "Surgically Precise"
		  				break;
		  			case("all_stars"):
		  				msg = "All-Star"
		  				break;
		  			default:
		  				msg = "";
		  		}

		  		return msg;
		  	},
		  	prevWeek:function() { if(this.selectedWeek > 0) this.selectedWeek--; },
		  	nextWeek:function() { if(this.selectedWeek < this.activity_reports.length - 1) this.selectedWeek++; },
		  	getTeamName:function(teamId) {
		  		for(var x=0;x<this.teams.length;x++) {
		  			if(this.teams[x].id == teamId) return this.teams[x].name;
		  		}
		  		return teamId;
		  	},
		  	getTeamIcon:function(teamId) {
		  		for(var x=0;x<this.teams.length;x++) {
		  			if(this.teams[x].id == teamId) return '/images/icons/' + this.teams[x].icon + '.png';
		  		}
		  		return '';
		  	},
		  	getTeamData:function(teamId) {
		  		for(var x=0;x<this.teams.length;x++) {
		  			if(this.teams[x].id == teamId) return this.teams[x];
		  		}
		  		return null;
		  	},
		  	highestPoints:function(dist) {
		  		var fakeDist = Object.assign({}, dist);
		  		delete fakeDist.total;
		  		delete fakeDist.details;

		  		var html = "";
		  		var highest = Object.keys(fakeDist).reduce((a, b) => fakeDist[a] > fakeDist[b] ? a : b);
		  		delete fakeDist[highest];
		  		var secondHighest = Object.keys(fakeDist).reduce((a, b) => fakeDist[a] > fakeDist[b] ? a : b);

		  		msg = this.titles(highest);
		  		msg += ` (${dist[highest]}pts)`
		  		msg += this.titles(secondHighest);

		  		html = `
		  			${this.titles(highest)} (${dist[highest]}pts)
		  		`

		  		return html;
		  	}
		  }
		})