extends layout

block content
	div#content
		div#proplayers
			draft_info(
				v-bind:league_info="league_info",
				v-bind:status_slug="statusSlug",
				current_page="players"
			)

			div#player-filtering

				h3 Role Select:
				select(name="role_select" @change="resetFetch" v-model="tag").role_select
					option(value="dps" v-selected) DPS
					option(value="tanks") Tanks
					option(value="healers") Healers

				h3 Search by Name:
				input(type="text", v-model="playername", @change="fetchSource")

				h3 Search by Guild:
				input(type="text", v-model="guild", @change="fetchSource")

				br
				button(v-on:click="pageDown").pageButton
					i.fas.fa-arrow-circle-left
				h2.pageIndicator Page: {{ page+1 }}
				button(v-on:click="pageUp").pageButton
					i.fas.fa-arrow-circle-right

			div#player-display
				ul(v-if=found)#players
					player-item(
						v-for="(player, index) in players",
						v-bind:player="player",
						v-bind:leagueID="leagueID"
					)
				h2(v-else) Player(s) not found.

	script.
		var leagueID = "!{leagueID}";
		var league = JSON.parse('!{league}');


		Vue.component('draft_info', {
			props: ['league_info', 'status_slug', 'current_page'],
			template: `
			<div class="league-header">
				<div class="league-header-top">
					<img class="league-header-icon" :src="'/images/league_icons/' + league_info.icon">
					<h1 class="league-header-name" :style="'color:'+league_info.color1">{{league_info.name}}</h1>
					<span class="status-badge" :class="status_slug">{{league_info.status}}</span>
				</div>
				<div class="league-header-meta">
					<span class="meta-chip">{{league_info.server || 'Any Server'}}</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{league_info.faction || 'Any'}}</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{league_info.style || 'Snake'}} Draft</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{league_info.report_day || 'Monday'}} reports</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">Org: {{league_info.admin.name}}</span>
				</div>
				<div class="league-header-nav">
					<a :href="'/leagues/' + league_info.code" :class="{active: current_page === 'home'}"><i class="fas fa-home"></i> Home</a>
					<a :href="'/leagues/' + league_info.code + '/teams'" :class="{active: current_page === 'teams'}"><i class="fas fa-flag"></i> Teams</a>
					<a :href="'/leagues/' + league_info.code + '/rankings'" :class="{active: current_page === 'rankings'}"><i class="fas fa-calendar-alt"></i> Rankings</a>
					<a :href="'/proplayers/' + league_info.code" :class="{active: current_page === 'players'}"><i class="fas fa-list"></i> Players</a>
				</div>
			</div>
			`
		})

		Vue.component('player-item', {
			props: ['player', 'leagueID'],
		 	template: `
		 	<li :class="'player ' + player.class"> 

		 	<div id="player-info"> 
			 	<div id="info">
				 	<h2> {{player.name}} </h2>
				 	<h3> {{player.guild}} </h3>
				 	<span v-if="player.active === false" class="inactive_badge">Inactive</span>
				 	<h3> {{player.rankings[0].spec}} {{player.class}}</h3>
			 	</div>

			 	<div id="averages">
				 	<div v-if="player.avgParse != null" id="avg_parse_badge">
				 		<span id="avg_parse" class="parse">{{Math.round(player.avgParse)}}</span>
				 		<span>Average Parse</span>
				 	</div>

				 	<div v-if="player.avgDps != null" id="avg_dps_badge">
			 			<span id="avg_dps">{{Math.round(player.avgDps)}}</span>
			 			<span>Average DPS</span>
			 		</div>

			 		<div v-if="player.avgSpeed != null" id="avg_speed_badge">
			 			<span id="avg_speed" class="parse">{{Math.round(player.avgSpeed)}}</span>
			 			<span>Average Speed</span>
			 		</div>
			 	</div>
		 	</div> 
		 	<div id="rankings">
		 	<player-rankings 
				v-for="ranking in player.rankings.slice(0, 4)"
				v-bind:rankings="ranking"
			>
			</div>

		 	<form v-if="!{onClock}" action="/leagues/api/${leagueID}/draftPlayer" method='post'>
		 		<input type="hidden" name="player_name" :value="player.name">
		 		<button type="submit" class="draft_button"> <h3> <i class="fas fa-handshake"></i> draft this player </h3> </button>
		 	</form>

		 	</li>'`
		})

		//- <a v-if="!{onClock}"> draft me! </a>
		Vue.component('player-rankings', {
			props: ['rankings'],
			template: `
				<li class="parseBadge"> 

				<span id="encounter_boss"> {{rankings.encounter_data.encounter.name}} </span> 

				<span id="encounter_rankPercent" class="parse">{{rankings.rankPercent}}</span> 

				</li>`
		})

		var app = new Vue({
			el: '#proplayers',
			data: {
					players: [],
					found: true,
					page: 0,
					tag: "dps",
					leagueID: leagueID,
					league_info: league,
					playername: "",
					guild: "",
					lastSource: "generic",
			},
			computed: {
				statusSlug() {
					return this.league_info.status.toLowerCase().replace(" ", '-');
				}
			},
			methods: {
				fetchSource:function(event) {
					var newSource = "generic";
					if(this.playername != "") {
						this.fetchPlayer();
						newSource = "player";
					} else if(this.guild != "") {
						this.fetchGuild();
						newSource = "guild";
					} else {
						this.fetchData();
					}

					if(this.lastSource != newSource) {
						this.lastSource = newSource;
						this.page = 0;
					}
				},
				fetchData: function(event) {
					fetch(`/proplayers/api/${this.leagueID}/${this.tag}/${this.page}`)
					.then(res => res.json())
					.then((response) => {
						app.players = response;
						console.log(response);
					})
					.then(() => {
						$('.parse').each((i, obj) => {
							var obj = $(obj);
							obj.css("color", parseStyle(obj.text()))
						})
					})
					.catch((err) => {
						console.log(err);
					})
				},

				fetchPlayer:function(event) {
					fetch(`/proplayers/api/${this.leagueID}/${this.tag}/search/${this.playername}`)
					.then(res => res.json())
					.then((response) => {
						if(response != null) {
							app.players = response;
							app.found = true;
						} else {
							app.players = [];
							app.found = false;
						}
					})
					.then(() => {
						$('.parse').each((i, obj) => {
							var obj = $(obj);
							obj.css("color", parseStyle(obj.text()))
						})
					})
					.catch((err) => {
						console.log(err);
					})
				},

				fetchGuild:function(event) {
					fetch(`/proplayers/api/${this.leagueID}/${this.tag}/guild/${this.guild}/${this.page}`)
					.then(res => res.json())
					.then((response) => {
						console.log(response);
						if(response != null) {
							app.players = response;
							app.found = true;
						} else {
							app.players = [];
							app.found = false;
						}
					})
					.then(() => {
						$('.parse').each((i, obj) => {
							var obj = $(obj);
							obj.css("color", parseStyle(obj.text()))
						})
					})
					.catch((err) => {
						console.log(err);
					})
				},

				pageDown:function(event) {
					if(this.page-1 < 0) {
						return;
					}
					this.page--;
					this.fetchSource();
				},
				pageUp:function(event) {
					this.page++;
					this.fetchSource();
				},
				resetFetch:function(event){
					this.page = 0;
					this.fetchSource();
				}
			}
		})

		function parseStyle(parse){
			var color = "Gray";
			parse=parseInt(parse);

			if(parse < 25) {
				color = "Gray"
			} else if(parse < 50) {
				color = "Green"
			} else if(parse < 75) {
				color = "Blue"
			} else if(parse < 95) {
				color = "Purple"
			} else if(parse < 99) {
				color = "Orange"
			} else {
				color = "Gold"
			}

			return color;
		}

		app.fetchData("dps", 0);

