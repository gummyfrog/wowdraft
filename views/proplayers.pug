extends layout

block content
	div#content
		div#proplayers
			draft_info(
				v-bind:league_info="league_info",
				v-bind:status_slug="statusSlug",
				v-bind:is_admin="organizer",
				current_page="players"
			)

			div(v-if="yourTeam && league_info.requirements").requirements-tracker
				span.req-label Need:
				span.req-slot(:class="{fulfilled: tanksNeeded === 0}")
					span.req-count {{tanksNeeded}}
					span Tank(s)
				span.req-slot(:class="{fulfilled: dpsNeeded === 0}")
					span.req-count {{dpsNeeded}}
					span DPS
				span.req-slot(:class="{fulfilled: healersNeeded === 0}")
					span.req-count {{healersNeeded}}
					span Healer(s)

			div.player-filters
				div.filter-group
					div.role-tabs
						button.role-tab(:class="{active: tag === 'dps'}" @click="setTag('dps')") DPS
						button.role-tab(:class="{active: tag === 'tanks'}" @click="setTag('tanks')") Tanks
						button.role-tab(:class="{active: tag === 'healers'}" @click="setTag('healers')") Healers
				div.filter-group
					label Name:
					input(type="text" v-model="playername" @input="debouncedFetch" placeholder="Search...")
				div.filter-group
					label Guild:
					input(type="text" v-model="guild" @input="debouncedFetch" placeholder="Filter guild...")
				div.player-pagination
					button(@click="pageDown" :disabled="page === 0").pageButton
						i.fas.fa-chevron-left
					span Page {{page + 1}}
					button(@click="pageUp" :disabled="!hasMore").pageButton
						i.fas.fa-chevron-right

			div#player-display
				table.player-table(v-if="found")
					thead
						tr
							th
							th.sortable-th(@click="sortBy('name')")
								| Player
								i.fas.fa-sort-up.sort-icon(v-if="sortKey === 'name' && sortAsc")
								i.fas.fa-sort-down.sort-icon(v-if="sortKey === 'name' && !sortAsc")
							th Role
							th.sortable-th(@click="sortBy('avgParse')")
								| Parse
								i.fas.fa-sort-up.sort-icon(v-if="sortKey === 'avgParse' && sortAsc")
								i.fas.fa-sort-down.sort-icon(v-if="sortKey === 'avgParse' && !sortAsc")
							th.sortable-th(v-if="tag === 'dps'" @click="sortBy('avgDps')")
								| DPS
								i.fas.fa-sort-up.sort-icon(v-if="sortKey === 'avgDps' && sortAsc")
								i.fas.fa-sort-down.sort-icon(v-if="sortKey === 'avgDps' && !sortAsc")
							th(v-if="onClock")
					tbody
						tr(v-for="player in sortedPlayers" :class="['player-row', {inactive: player.active === false}]" :style="'border-left: 3px solid var(--' + player.class.toLowerCase() + ', #555)'")
							td.player-class-cell
								div.class-icon-ring(:style="'background: var(--' + player.class.toLowerCase() + ', #555)'")
									img(:src="'/images/classes/'+player.class+'.png'")
							td.player-identity-cell
								div.player-name-text(:class="'class-' + player.class") {{player.name}}
								div.player-guild-sub
									i.fas.fa-shield-alt.guild-icon
									| {{player.guild}}
							td
								span.role-pill(:class="player.tag") {{player.tag === 'dps' ? 'DPS' : player.tag === 'tanks' ? 'Tank' : 'Healer'}}
							td
								div.parse-cell(v-if="player.avgParse != null")
									div.parse-bar(:style="'width:' + Math.round(player.avgParse) + '%; background:' + parseColor(player.avgParse)")
									span.parse-value(:style="'color:' + parseColor(player.avgParse)") {{Math.round(player.avgParse)}}
									span.parse-tier(:style="'color:' + parseColor(player.avgParse)") {{parseTier(player.avgParse)}}
								span.parse-value.parse-none(v-else) --
							td(v-if="tag === 'dps'")
								span.dps-value(v-if="player.avgDps != null") {{formatDps(player.avgDps)}}
								span.dps-value.parse-none(v-else) --
							td(v-if="onClock")
								form(v-if="player.active !== false" :action="'/leagues/api/' + leagueID + '/draftPlayer'" method="post" style="display:inline")
									input(type="hidden" name="player_name" :value="player.name")
									button(type="submit").draft-btn Draft
								span(v-else style="opacity:0.4; font-size:0.8em") Inactive
				div.empty-state(v-else)
					i.fas.fa-search.empty-state-icon
					p.empty-state-message No players found
					p.empty-state-subtext Try a different search, guild filter, or role tab.

	script.
		var leagueID = "!{leagueID}";
		var league = !{JSON.stringify(league)};
		league = JSON.parse(league);
		var yourTeam = !{JSON.stringify(yourTeam)};
		yourTeam = yourTeam ? JSON.parse(yourTeam) : null;
		var onClock = !{onClock};
		var PAGE_SIZE = 10;

		Vue.component('draft_info', {
			props: ['league_info', 'status_slug', 'current_page', 'is_admin'],
			template: `
			<div class="league-header">
				<div class="league-header-top">
					<img class="league-header-icon" :src="'/images/league_icons/' + league_info.icon">
					<h1 class="league-header-name" :style="'color:'+league_info.color1">{{league_info.name}}</h1>
					<span class="status-badge" :class="status_slug">{{league_info.status}}</span>
				</div>
				<div class="league-header-meta">
					<span class="meta-chip">{{league_info.game_version === 'classic' ? 'Classic' : 'Retail'}}</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{(league_info.region || 'us').toUpperCase()}}</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{league_info.style || 'Snake'}} Draft</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">{{league_info.report_day || 'Monday'}} reports</span>
					<span class="meta-sep">&middot;</span>
					<span class="meta-chip">Org: {{league_info.admin.name}}</span>
				</div>
				<div class="league-header-nav">
					<a :href="'/leagues/' + league_info.code" :class="{active: current_page === 'home'}"><i class="fas fa-home"></i> Home</a>
					<a :href="'/leagues/' + league_info.code + '/teams'" :class="{active: current_page === 'teams'}"><i class="fas fa-flag"></i> Teams</a>
					<a :href="'/leagues/' + league_info.code + '/rankings'" :class="{active: current_page === 'rankings'}"><i class="fas fa-calendar-alt"></i> Rankings</a>
					<a :href="'/proplayers/' + league_info.code" :class="{active: current_page === 'players'}"><i class="fas fa-list"></i> Players</a>
					<a :href="'/leagues/' + league_info.code + '/settings'" :class="{active: current_page === 'settings'}"><i class="fas fa-cog"></i> {{is_admin ? 'Settings' : 'Info'}}</a>
				</div>
			</div>
			`
		})

		var app = new Vue({
			el: '#proplayers',
			data: {
				players: [],
				found: true,
				hasMore: true,
				page: 0,
				tag: "dps",
				leagueID: leagueID,
				league_info: league,
				organizer: !{organizer},
				yourTeam: yourTeam,
				onClock: onClock,
				playername: "",
				guild: "",
				sortKey: '',
				sortAsc: true,
				lastSource: "generic",
				debounceTimer: null,
			},
			computed: {
				statusSlug() {
					return this.league_info.status.toLowerCase().replace(" ", '-');
				},
				sortedPlayers() {
					if (!this.sortKey) return this.players;
					var key = this.sortKey;
					var asc = this.sortAsc;
					return this.players.slice().sort(function(a, b) {
						var va = a[key], vb = b[key];
						if (va == null) return 1;
						if (vb == null) return -1;
						if (va < vb) return asc ? -1 : 1;
						if (va > vb) return asc ? 1 : -1;
						return 0;
					});
				},
				tanksNeeded() {
					if (!this.yourTeam || !this.league_info.requirements) return 0;
					return Math.max(0, this.league_info.requirements.tanks - (this.yourTeam.roles_drafted ? this.yourTeam.roles_drafted.tanks : 0));
				},
				dpsNeeded() {
					if (!this.yourTeam || !this.league_info.requirements) return 0;
					return Math.max(0, this.league_info.requirements.dps - (this.yourTeam.roles_drafted ? this.yourTeam.roles_drafted.dps : 0));
				},
				healersNeeded() {
					if (!this.yourTeam || !this.league_info.requirements) return 0;
					return Math.max(0, this.league_info.requirements.healers - (this.yourTeam.roles_drafted ? this.yourTeam.roles_drafted.healers : 0));
				},
			},
			methods: {
				parseColor(parse) {
					parse = parseInt(parse);
					if (parse < 25) return '#666';
					if (parse < 50) return '#1eff00';
					if (parse < 75) return '#0070dd';
					if (parse < 95) return '#a335ee';
					if (parse < 99) return '#ff8000';
					return '#e5cc80';
				},
				parseTier(parse) {
					parse = parseInt(parse);
					if (parse < 25) return 'Common';
					if (parse < 50) return 'Uncommon';
					if (parse < 75) return 'Rare';
					if (parse < 95) return 'Epic';
					if (parse < 99) return 'Legendary';
					return 'Artifact';
				},
				formatDps(dps) {
					if (dps >= 1000000) return (dps / 1000000).toFixed(1) + 'M';
					if (dps >= 1000) return (dps / 1000).toFixed(1) + 'K';
					return Math.round(dps);
				},
				sortBy(key) {
					if (this.sortKey === key) {
						this.sortAsc = !this.sortAsc;
					} else {
						this.sortKey = key;
						this.sortAsc = true;
					}
				},
				setTag(tag) {
					this.tag = tag;
					this.page = 0;
					this.fetchSource();
				},
				debouncedFetch() {
					clearTimeout(this.debounceTimer);
					var self = this;
					this.debounceTimer = setTimeout(function() { self.page = 0; self.fetchSource(); }, 300);
				},
				fetchSource: function() {
					if (this.playername != "") {
						this.fetchPlayer();
					} else if (this.guild != "") {
						this.fetchGuild();
					} else {
						this.fetchData();
					}
				},
				handleResponse: function(response) {
					this.players = response;
					this.found = response.length > 0;
					this.hasMore = response.length >= PAGE_SIZE;
				},
				fetchData: function() {
					var self = this;
					fetch('/proplayers/api/' + this.leagueID + '/' + this.tag + '/' + this.page)
						.then(function(res) { return res.json(); })
						.then(function(response) { self.handleResponse(response); })
						.catch(function(err) { console.log(err); });
				},
				fetchPlayer: function() {
					var self = this;
					fetch('/proplayers/api/' + this.leagueID + '/' + this.tag + '/search/' + this.playername)
						.then(function(res) { return res.json(); })
						.then(function(response) {
							if (response != null) {
								self.handleResponse(response);
							} else {
								self.players = [];
								self.found = false;
								self.hasMore = false;
							}
						})
						.catch(function(err) { console.log(err); });
				},
				fetchGuild: function() {
					var self = this;
					fetch('/proplayers/api/' + this.leagueID + '/' + this.tag + '/guild/' + this.guild + '/' + this.page)
						.then(function(res) { return res.json(); })
						.then(function(response) {
							if (response != null) {
								self.handleResponse(response);
							} else {
								self.players = [];
								self.found = false;
								self.hasMore = false;
							}
						})
						.catch(function(err) { console.log(err); });
				},
				pageDown: function() {
					if (this.page > 0) {
						this.page--;
						this.fetchSource();
					}
				},
				pageUp: function() {
					if (this.hasMore) {
						this.page++;
						this.fetchSource();
					}
				},
			}
		})

		app.fetchData();
